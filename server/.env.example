# JWT secrets — generate strong random values for production
# You can use: openssl rand -base64 48
JWT_SECRET=change-this-to-a-random-secret
JWT_REFRESH_SECRET=change-this-to-another-random-secret

# Neon Postgres — required now (replaces local SQLite file)
# From Neon console > Connection details. Dev uses the dev branch, prod uses main.
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/spiritarc
PG_SCHEMA=public

# Admin auto-seed on first run
ADMIN_EMAIL=
ADMIN_PASSWORD=

# AI reading API
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1

# Production
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173
